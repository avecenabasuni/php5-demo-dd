{
  "title": "SIAKAD - Sistem Informasi Akademik (Demo)",
  "description": "Dashboard monitoring untuk aplikasi SIAKAD PHP 5 — Login activity, Error rates, Page performance, KRS activity, dan Feature Flags status.",
  "widgets": [
    {
      "definition": {
        "title": "Login Activity (Success vs Failure)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:siakad.login.success{env:demo}.as_count()",
            "display_type": "bars",
            "style": {"palette": "green"}
          },
          {
            "q": "sum:siakad.login.failure{env:demo}.as_count()",
            "display_type": "bars",
            "style": {"palette": "red"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Error Count by Type",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:siakad.error.count{env:demo} by {error_type}.as_count()",
            "display_type": "bars",
            "style": {"palette": "warm"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Page Load Time (P50 / P95 / P99)",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:siakad.page.load_time{env:demo}",
            "display_type": "line",
            "style": {"palette": "blue"}
          },
          {
            "q": "p95:siakad.page.load_time{env:demo}",
            "display_type": "line",
            "style": {"palette": "orange"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "DB Query Time",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:siakad.db.query_time{env:demo} by {type}",
            "display_type": "line",
            "style": {"palette": "purple"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Total Login Attempts",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:siakad.login.attempt{env:demo}.as_count()",
            "aggregator": "sum"
          }
        ],
        "precision": 0
      }
    },
    {
      "definition": {
        "title": "Total Errors",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:siakad.error.count{env:demo}.as_count()",
            "aggregator": "sum"
          }
        ],
        "precision": 0
      }
    },
    {
      "definition": {
        "title": "Feature Flags Blocked",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:siakad.feature_flag.blocked{env:demo}.as_count()",
            "aggregator": "sum"
          }
        ],
        "precision": 0
      }
    },
    {
      "definition": {
        "title": "Demo Errors Triggered",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:siakad.demo.error_triggered{env:demo} by {type}.as_count()",
            "display_type": "bars",
            "style": {"palette": "cool"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "DB Errors",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:siakad.db.error{env:demo} by {type}.as_count()",
            "display_type": "bars",
            "style": {"palette": "red"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Business Logic Errors",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:siakad.error.business_logic{env:demo} by {code}.as_count()",
            "display_type": "bars",
            "style": {"palette": "orange"}
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Log Stream (SIAKAD)",
        "type": "log_stream",
        "query": "service:siakad",
        "columns": ["timestamp", "level", "message"],
        "message_display": "expanded_md"
      }
    },
    {
      "definition": {
        "title": "Error Logs by Level",
        "type": "timeseries",
        "requests": [
          {
            "q": "count:logs(\"service:siakad level:error\"){*}.as_count()",
            "display_type": "bars",
            "style": {"palette": "red"}
          },
          {
            "q": "count:logs(\"service:siakad level:warning\"){*}.as_count()",
            "display_type": "bars",
            "style": {"palette": "yellow"}
          },
          {
            "q": "count:logs(\"service:siakad level:critical\"){*}.as_count()",
            "display_type": "bars",
            "style": {"palette": "orange"}
          }
        ]
      }
    }
  ],
  "template_variables": [
    {
      "name": "env",
      "default": "demo",
      "prefix": "env"
    },
    {
      "name": "service",
      "default": "siakad",
      "prefix": "service"
    }
  ],
  "layout_type": "ordered",
  "notify_list": [],
  "reflow_type": "fixed"
}
